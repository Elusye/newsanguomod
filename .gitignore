# Godot 4+ specific ignores
.godot/
/android/

# IDE / 编辑器缓存（含本机路径等个人信息）
.idea/
.vs/
*.user

# 本机游戏目录与 Godot 路径（由 local.props.example 复制而来）
local.props

# 本地诊断日志
debug.log

# 会话中拖入的游戏日志等临时文件（含玩家 SteamID，不要提交）
.dsh-drop/

# 构建产物（保险）
bin/
obj/
__pycache__/
*.pyc

# 本地反编译/临时产物
.decomp_tmp/
# 引擎/RitsuLib 反编译产物（体积大、且是他人代码，不要公开）
.decompile/

# TRAE IDE 本地配置
.trae/

# PostHog CLI credentials (local only, do not commit)
.posthog-home/
.posthog.env

# PostHog 分析产物快照（查询语句 analysis/posthog/*.sql 与 tools/*.ps1 可入库，生成的表/图不入库）
analysis/posthog/out/
