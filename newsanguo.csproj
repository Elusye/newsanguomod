<Project Sdk="Godot.NET.Sdk/4.5.1">
    <!-- 本机路径。命令行 -p:Sts2Dir= 优先于 local.props。 -->
    <Import Project="local.props" Condition="Exists('local.props')" />

    <PropertyGroup>
        <!-- 如果你安装了10.0并遇到问题，改下这里 -->
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>true</ImplicitUsings>
        <LangVersion>13.0</LangVersion>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <PackageOutputDir Condition="'$(PackageOutputDir)' == ''">$(MSBuildProjectDirectory)\artifacts\newsanguo-0.3.8-release.1-sts2-0.107.1\mods\newsanguo</PackageOutputDir>

        <GameReferenceRoot Condition="'$(GameReferenceRoot)' == ''">$(MSBuildProjectDirectory)\..\references\sts2-0.107.1</GameReferenceRoot>
        <Sts2DataDir Condition="'$(Sts2DataDir)' == ''">$(GameReferenceRoot)\data_sts2_windows_x86_64</Sts2DataDir>

    </PropertyGroup>

    <ItemGroup>
        <Reference Include="sts2">
            <HintPath>$(Sts2DataDir)\sts2.dll</HintPath>
            <Private>false</Private>
        </Reference>

        <Reference Include="0Harmony">
            <HintPath>$(Sts2DataDir)\0Harmony.dll</HintPath>
            <Private>false</Private>
        </Reference>

        <Reference Include="SmartFormat">
            <HintPath>$(Sts2DataDir)\SmartFormat.dll</HintPath>
            <Private>false</Private>
        </Reference>

        <!-- NuGet获取。0.6.x 起 RitsuLib 拆成 facade + Runtime/Shared/Ui/Settings 多个程序集，
             必须与玩家安装的运行时严格同版本（不同大版本之间二进制不兼容，会 FileLoadException）：
             1) 用 [0.6.2] 精确锁定——写成 Version="0.6.2" 会被 NuGet 当作“最低版本”，
                日后可能自动拉到更新的不兼容版本（此前 Version="*" 就是这样把 0.5.x 拉到 0.6.2 的）；
             2) 0.6.2 的兼容目标是游戏 API 0.107.1，与 newsanguo.json 的 min_game_version 一致；
             3) 框架本体不随本 mod 分发，由 mods/STS2-RitsuLib 运行时提供（见下方 Target）。 -->
        <PackageReference Include="STS2.RitsuLib.Compat.0.107.1" Version="[0.6.2]" />
    </ItemGroup>

    <Target Name="Validate Reference Paths" BeforeTargets="ResolveAssemblyReferences">
        <Error Condition="!Exists('$(Sts2DataDir)\sts2.dll')"
               Text="缺少0.107.1游戏程序集，请配置 GameReferenceRoot 或 Sts2DataDir。" />
        <Error Condition="'$(DeployMod)' == 'true' AND '$(Sts2Dir)' == ''"
               Text="部署需要配置 Sts2Dir；默认只构建，不自动部署。" />
    </Target>

    <!-- 默认只输出到Release本地安装包；必须显式DeployMod=true才部署Steam。 -->
    <Target Name="Stage Mod" AfterTargets="PostBuildEvent">
        <MakeDir Directories="$(PackageOutputDir)" />
        <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PackageOutputDir)" />
        <Copy SourceFiles="$(MSBuildProjectName).json" DestinationFolder="$(PackageOutputDir)" />
    </Target>
    <!-- 自动复制dll和json（RitsuLib 本体由 mods/STS2-RitsuLib 运行时提供，不要复制进本 mod 目录：
         随 mod 携带的副本会按文件名抢占程序集解析，导致版本与运行时不一致（FileLoadException）。 -->
    <Target Name="Copy Mod" AfterTargets="PostBuildEvent" Condition="'$(DeployMod)' == 'true'">
        <Message Text="Copying mod to Slay the Spire 2 mods folder..." Importance="high" />
        <MakeDir Directories="$(Sts2Dir)\mods\" />
        <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(Sts2Dir)\mods\$(MSBuildProjectName)\" />
        <Copy SourceFiles="$(MSBuildProjectName).json" DestinationFolder="$(Sts2Dir)/mods/$(MSBuildProjectName)/" />
    </Target>
</Project>
