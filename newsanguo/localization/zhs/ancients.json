{
  "DARV.talk.NEWSANGUO_CHARACTER_NEWSANGUO_CHARACTER.0-0.ancient": "又有新人来了？[jitter]尖塔前途灿烂呐！[/jitter]",
  "DARV.talk.NEWSANGUO_CHARACTER_NEWSANGUO_CHARACTER.0-0.next": "继续",
  "DARV.talk.NEWSANGUO_CHARACTER_NEWSANGUO_CHARACTER.0-1.char": "你这个人虽然迂腐，但你收藏的[gold][b]酒[/b][/gold]很不错。",
  "DARV.talk.NEWSANGUO_CHARACTER_NEWSANGUO_CHARACTER.0-1.next": "继续",
  "DARV.talk.NEWSANGUO_CHARACTER_NEWSANGUO_CHARACTER.0-2.ancient": "……居然有人会觉得千年以前的过期饮料会好喝？",
  "DARV.talk.NEWSANGUO_CHARACTER_NEWSANGUO_CHARACTER.1-0r.ancient": "你先前提到的“[red][b]天意[/b][/red]”，在尖塔好像也有类似的存在。",
  "DARV.talk.NEWSANGUO_CHARACTER_NEWSANGUO_CHARACTER.2-0.ancient": "我的新朋友，我可有[b]好东西[/b]给你呀！",
  "DARV.talk.NEWSANGUO_CHARACTER_NEWSANGUO_CHARACTER.2-0.next": "回答",
  "DARV.talk.NEWSANGUO_CHARACTER_NEWSANGUO_CHARACTER.2-1.char": "你还是个忠厚人哪！",
  "DARV.talk.NEWSANGUO_CHARACTER_NEWSANGUO_CHARACTER.2-1.next": "继续",
  "DARV.talk.NEWSANGUO_CHARACTER_NEWSANGUO_CHARACTER.2-2.ancient": "了不起，一开口便是大实话。",

  "NEOW.talk.NEWSANGUO_CHARACTER_NEWSANGUO_CHARACTER.0-0.char": "这位是…对不住我实在是记不住你的名字了。请问你知道[gold][b]安东尼[/b][/gold]在哪吗？",
  "NEOW.talk.NEWSANGUO_CHARACTER_NEWSANGUO_CHARACTER.0-0.next": "继续",
  "NEOW.talk.NEWSANGUO_CHARACTER_NEWSANGUO_CHARACTER.0-1.ancient": "[sine]…他的…老爸…住在…这…[/sine]",
  "NEOW.talk.NEWSANGUO_CHARACTER_NEWSANGUO_CHARACTER.1-0r.ancient": "[sine]天意…也想…除掉…建筑…师吗…[/sine]",
  "NEOW.talk.NEWSANGUO_CHARACTER_NEWSANGUO_CHARACTER.1-0r.next": "继续",
  "NEOW.talk.NEWSANGUO_CHARACTER_NEWSANGUO_CHARACTER.1-1r.char": "不错，你的吟诗水平和我有的一拼。",
  "NEOW.talk.NEWSANGUO_CHARACTER_NEWSANGUO_CHARACTER.2-0r.char": "[jitter]不可能！绝对不可能！[/jitter]",
  "NEOW.talk.NEWSANGUO_CHARACTER_NEWSANGUO_CHARACTER.2-0r.next": "继续",
  "NEOW.talk.NEWSANGUO_CHARACTER_NEWSANGUO_CHARACTER.2-1r.ancient": "[sine]…你…大败…而归……已成…哀兵…[/sine]",
  "NEOW.talk.NEWSANGUO_CHARACTER_NEWSANGUO_CHARACTER.2-1r.next": "继续",
  "NEOW.talk.NEWSANGUO_CHARACTER_NEWSANGUO_CHARACTER.2-2r.char": "[jitter]而哀兵必胜！[/jitter]",

  "NONUPEIPE.talk.NEWSANGUO_CHARACTER_NEWSANGUO_CHARACTER.0-0.ancient": "我有几千年都没有接待过访客了！哎呀，你的穿搭看起来有些乏味呢，来，我们给你挑些漂亮的穿吧。",
  "NONUPEIPE.talk.NEWSANGUO_CHARACTER_NEWSANGUO_CHARACTER.1-0r.ancient": "[red][b]天意爷[/b][/red]派来的访客，该有独特的赐福。仆人们！为我们倒点酒来。",
  "NONUPEIPE.talk.NEWSANGUO_CHARACTER_NEWSANGUO_CHARACTER.2-0r.ancient": "建筑师发了疯！他的愤怒正充斥着整座高塔！",
  "NONUPEIPE.talk.NEWSANGUO_CHARACTER_NEWSANGUO_CHARACTER.2-0r.next": "继续",
  "NONUPEIPE.talk.NEWSANGUO_CHARACTER_NEWSANGUO_CHARACTER.2-1r.char": "不要愤怒，愤怒会降低你的智慧。",
  "NONUPEIPE.talk.NEWSANGUO_CHARACTER_NEWSANGUO_CHARACTER.2-1r.next": "继续",
  "NONUPEIPE.talk.NEWSANGUO_CHARACTER_NEWSANGUO_CHARACTER.2-2r.ancient": "我为你准备了礼物，带吧，多带。",

  "OROBAS.talk.NEWSANGUO_CHARACTER_NEWSANGUO_CHARACTER.0-0.ancient": "异世界来的新人物？也只有半个身子？有意思！！",
  "OROBAS.talk.NEWSANGUO_CHARACTER_NEWSANGUO_CHARACTER.0-0.next": "继续",
  "OROBAS.talk.NEWSANGUO_CHARACTER_NEWSANGUO_CHARACTER.0-1.char": "我有两把剑，一把叫仁之剑，一把叫义之剑。",
  "OROBAS.talk.NEWSANGUO_CHARACTER_NEWSANGUO_CHARACTER.0-1.next": "继续",
  "OROBAS.talk.NEWSANGUO_CHARACTER_NEWSANGUO_CHARACTER.0-2.ancient": "好有意思的设定！再讲讲！！再讲讲！！",
  "OROBAS.talk.NEWSANGUO_CHARACTER_NEWSANGUO_CHARACTER.1-0r.ancient": "你能再讲讲从[red][b]天意爷[/b][/red]那里预见到的尖塔小故事吗？",
  "OROBAS.talk.NEWSANGUO_CHARACTER_NEWSANGUO_CHARACTER.1-0r.next": "继续",
  "OROBAS.talk.NEWSANGUO_CHARACTER_NEWSANGUO_CHARACTER.1-1r.char": "可以。[gold][b]安东尼[/b][/gold]和他老爸[red][b]盛碗虫（石）[/b][/red]住在山上的一所小房子里…",
  "OROBAS.talk.NEWSANGUO_CHARACTER_NEWSANGUO_CHARACTER.2-0r.ancient": "再给我解释一次[rainbow][b]325[/b][/rainbow]是什么意思吧！！",
  "OROBAS.talk.NEWSANGUO_CHARACTER_NEWSANGUO_CHARACTER.2-0r.next": "继续",
  "OROBAS.talk.NEWSANGUO_CHARACTER_NEWSANGUO_CHARACTER.2-1r.char": "真拿你没办法。坐好咯。（此处省略一万字）",

  "PAEL.talk.NEWSANGUO_CHARACTER_NEWSANGUO_CHARACTER.0-0.char": "风从虎，云从龙，龙虎英雄傲苍穹。",
  "PAEL.talk.NEWSANGUO_CHARACTER_NEWSANGUO_CHARACTER.0-0.next": "继续",
  "PAEL.talk.NEWSANGUO_CHARACTER_NEWSANGUO_CHARACTER.0-1.ancient": "[thinky_dots]又来了一个陌生人……\n拿一块上路吧……[/thinky_dots]",
  "PAEL.talk.NEWSANGUO_CHARACTER_NEWSANGUO_CHARACTER.1-0r.char": "龙可是帝王之征啊！",
  "PAEL.talk.NEWSANGUO_CHARACTER_NEWSANGUO_CHARACTER.1-0r.next": "继续",
  "PAEL.talk.NEWSANGUO_CHARACTER_NEWSANGUO_CHARACTER.1-1r.ancient": "[thinky_dots]随你怎么说……\n拿一块上路吧……[/thinky_dots]",
  "PAEL.talk.NEWSANGUO_CHARACTER_NEWSANGUO_CHARACTER.2-0r.char": "死是凉爽的夏夜，可供人无忧地安眠。",
  "PAEL.talk.NEWSANGUO_CHARACTER_NEWSANGUO_CHARACTER.2-0r.next": "继续",
  "PAEL.talk.NEWSANGUO_CHARACTER_NEWSANGUO_CHARACTER.2-1r.ancient": "[thinky_dots]我还没死呢……\nzZZzzz……[/thinky_dots]",

  "TANX.talk.NEWSANGUO_CHARACTER_NEWSANGUO_CHARACTER.0-0.ancient": "[b]半个身子的人？！\n用两把剑作为武器？！[/b]",
  "TANX.talk.NEWSANGUO_CHARACTER_NEWSANGUO_CHARACTER.0-0.next": "继续",
  "TANX.talk.NEWSANGUO_CHARACTER_NEWSANGUO_CHARACTER.0-1.char": "可别逼我使出无情剑法！",
  "TANX.talk.NEWSANGUO_CHARACTER_NEWSANGUO_CHARACTER.0-1.next": "继续",
  "TANX.talk.NEWSANGUO_CHARACTER_NEWSANGUO_CHARACTER.0-2.ancient": "[b]了不起！真是强大！！[/b]",
  "TANX.talk.NEWSANGUO_CHARACTER_NEWSANGUO_CHARACTER.1-0r.ancient": "[jitter]发兵器啦！！[/jitter]",
  "TANX.talk.NEWSANGUO_CHARACTER_NEWSANGUO_CHARACTER.2-0.ancient": "曹孟德，与我一战！！",
  "TANX.talk.NEWSANGUO_CHARACTER_NEWSANGUO_CHARACTER.2-0.next": "继续",
  "TANX.talk.NEWSANGUO_CHARACTER_NEWSANGUO_CHARACTER.2-1.char": "[i][font_size=22]一堆激烈的拼接打戏镜头。[/font_size][/i]",
  "TANX.talk.NEWSANGUO_CHARACTER_NEWSANGUO_CHARACTER.2-1.next": "继续",
  "TANX.talk.NEWSANGUO_CHARACTER_NEWSANGUO_CHARACTER.2-2.ancient": "这就是[red][b]天意[/b][/red]的力量吗？",

  "TEZCATARA.talk.NEWSANGUO_CHARACTER_NEWSANGUO_CHARACTER.0-0.ancient": "哇哈哈！又有新的客人来了！你好呀，小家伙~",
  "TEZCATARA.talk.NEWSANGUO_CHARACTER_NEWSANGUO_CHARACTER.0-0.next": "继续",
  "TEZCATARA.talk.NEWSANGUO_CHARACTER_NEWSANGUO_CHARACTER.0-1.char": "在下刘备，有礼。",
  "TEZCATARA.talk.NEWSANGUO_CHARACTER_NEWSANGUO_CHARACTER.0-1.next": "继续",
  "TEZCATARA.talk.NEWSANGUO_CHARACTER_NEWSANGUO_CHARACTER.0-2.ancient": "这名字还挺洋气的！来，尤里先生，吃点东西吧。",
  "TEZCATARA.talk.NEWSANGUO_CHARACTER_NEWSANGUO_CHARACTER.1-0r.ancient": "让我把你的火焰再[jitter][b]点亮一点[/b][/jitter]！！！",
  "TEZCATARA.talk.NEWSANGUO_CHARACTER_NEWSANGUO_CHARACTER.1-0r.next": "继续",
  "TEZCATARA.talk.NEWSANGUO_CHARACTER_NEWSANGUO_CHARACTER.1-1r.char": "好火啊，比夷陵之火还好啊！",
  "TEZCATARA.talk.NEWSANGUO_CHARACTER_NEWSANGUO_CHARACTER.2-0.ancient": "欢迎回来，天命人！又来找建筑师叠哀兵了？",

  "VAKUU.talk.NEWSANGUO_CHARACTER_NEWSANGUO_CHARACTER.0-0.ancient": "一个被[red][b]天意[/b][/red]操纵的傀儡？",
  "VAKUU.talk.NEWSANGUO_CHARACTER_NEWSANGUO_CHARACTER.0-0.next": "继续",
  "VAKUU.talk.NEWSANGUO_CHARACTER_NEWSANGUO_CHARACTER.0-1.ancient": "或许我会和这个[red][b]天意[/b][/red]有很多共同语言…",
  "VAKUU.talk.NEWSANGUO_CHARACTER_NEWSANGUO_CHARACTER.1-0r.ancient": "别再让[red][b]天意[/b][/red]接管你了，让我也接管你一会试试，我保证你不会后悔的！",
  "VAKUU.talk.NEWSANGUO_CHARACTER_NEWSANGUO_CHARACTER.2-0.ancient": "[red][b]天意爷[/b][/red]，我们的目标是一样的。",
  "VAKUU.talk.NEWSANGUO_CHARACTER_NEWSANGUO_CHARACTER.2-0.next": "继续",
  "VAKUU.talk.NEWSANGUO_CHARACTER_NEWSANGUO_CHARACTER.2-1.char": "（[red][b]天意爷[/b][/red]的声音从空中传来）[i][font_size=22][gold][b]东尼[/b][/gold]意思。[/font_size][/i]",

  "THE_ARCHITECT.talk.NEWSANGUO_CHARACTER_NEWSANGUO_CHARACTER.0-0.ancient": "你是何人？",
  "THE_ARCHITECT.talk.NEWSANGUO_CHARACTER_NEWSANGUO_CHARACTER.0-0.next": "继续",
  "THE_ARCHITECT.talk.NEWSANGUO_CHARACTER_NEWSANGUO_CHARACTER.0-1.char": "就说刺董失败的钦犯曹孟德前来拜访。如果提曹操的首级献入京城，朝廷赏千金，封万户侯！",
  "THE_ARCHITECT.talk.NEWSANGUO_CHARACTER_NEWSANGUO_CHARACTER.0-1.next": "继续",
  "THE_ARCHITECT.talk.NEWSANGUO_CHARACTER_NEWSANGUO_CHARACTER.0-2.ancient": "说什么乱七八糟的，我听不懂。",
  "THE_ARCHITECT.talk.NEWSANGUO_CHARACTER_NEWSANGUO_CHARACTER.0-startattack": "Player",
  "THE_ARCHITECT.talk.NEWSANGUO_CHARACTER_NEWSANGUO_CHARACTER.1-0r.ancient": "你和那个只有半个身子的忍者是什么关系？",
  "THE_ARCHITECT.talk.NEWSANGUO_CHARACTER_NEWSANGUO_CHARACTER.1-0r.next": "继续",
  "THE_ARCHITECT.talk.NEWSANGUO_CHARACTER_NEWSANGUO_CHARACTER.1-1r.char": "也许世人昨日看错了我曹操，今日又看错，或许明日还看错，但我仍然是我，我从来都不怕别人看错我。",
  "THE_ARCHITECT.talk.NEWSANGUO_CHARACTER_NEWSANGUO_CHARACTER.1-1r.next": "继续",
  "THE_ARCHITECT.talk.NEWSANGUO_CHARACTER_NEWSANGUO_CHARACTER.1-2r.ancient": "[jitter]呵啊！[/jitter]\n[jitter][red]死吧！！[/red][/jitter]",
  "THE_ARCHITECT.talk.NEWSANGUO_CHARACTER_NEWSANGUO_CHARACTER.1-startattack": "Player",
  "THE_ARCHITECT.talk.NEWSANGUO_CHARACTER_NEWSANGUO_CHARACTER.2-0r.ancient": "你怎么又跑进塔里来了？",
  "THE_ARCHITECT.talk.NEWSANGUO_CHARACTER_NEWSANGUO_CHARACTER.2-0r.next": "继续",
  "THE_ARCHITECT.talk.NEWSANGUO_CHARACTER_NEWSANGUO_CHARACTER.2-1r.char": "只要我曹孟德一息尚存，他就战无不胜！",
  "THE_ARCHITECT.talk.NEWSANGUO_CHARACTER_NEWSANGUO_CHARACTER.2-1r.next": "继续",
  "THE_ARCHITECT.talk.NEWSANGUO_CHARACTER_NEWSANGUO_CHARACTER.2-2r.ancient": "阿瞒，不是我害了你，是这个乱世害了你啊！",
  "THE_ARCHITECT.talk.NEWSANGUO_CHARACTER_NEWSANGUO_CHARACTER.2-startattack": "Player"
}
